DATABASE_URL=postgresql://user:password@localhost:5432/lisa
# Genereer met: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONVERSATION_ENCRYPTION_KEY=

# OpenAI Realtime — voert het volledige gesprek (spraak, beslissen, tools)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy

PORT=8000
CONVERSATION_HISTORY_LIMIT=20
CONVERSATION_RETENTION_DAYS=180

# Dashboard (intern, /dashboard) — leeg wachtwoord = toegang geweigerd
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# E-mail (escalatienotificaties + dagelijkse backup) — Gmail API, NIET SMTP
